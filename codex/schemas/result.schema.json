{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fca1/KiCadRoutingTools/codex/schemas/result.schema.json",
  "title": "Independent Codex gloss host result",
  "type": "object",
  "required": ["valid", "input", "output", "scope", "drc_before", "drc_after"],
  "additionalProperties": true,
  "properties": {
    "valid": {"type": "boolean"},
    "input": {"type": "string"},
    "output": {"type": "string"},
    "scope": {"type": "object"},
    "agent_exit_code": {"type": "integer"},
    "drc_before": {"type": "object"},
    "drc_after": {"type": "object"},
    "new_drc_categories": {"type": "object"}
  }
}
