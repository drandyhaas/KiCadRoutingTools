{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fca1/KiCadRoutingTools/codex/schemas/scope.schema.json",
  "title": "KiCad Track Gloss scope manifest",
  "type": "object",
  "required": ["scopes"],
  "additionalProperties": false,
  "properties": {
    "scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "anyOf": [
          {"const": "ALL"},
          {"pattern": "^net:.+$"},
          {"pattern": "^segment:[0-9A-Fa-f-]+$"}
        ]
      }
    }
  }
}
