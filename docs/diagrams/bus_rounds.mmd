flowchart TD
    START(["one bus: up to R rounds"])
    KIND{"this round"}
    subgraph ROUND["a round"]
        E["ends + fanout"]
        CHK{"escape bus:<br/>the solve's check,<br/>5 at most"}
        S["the round's solve (CP-SAT)"]
        subgraph LOOP["the loop, 6 rounds at most"]
            G["geometry (LP) and polish"]
            N["snap to the grid"]
            A{"audit"}
            RS["solve again<br/>with the cuts"]
        end
        L["lay the copper"]
        GR{"graded"}
    end
    STOP(["done"])
    NEXT{"a feedback round left?"}
    FB(["next: a feedback round<br/>(back to the top)"])
    DR(["next: a new draw<br/>(back to the top)"])
    BEST(["the best round;<br/>nothing laid: the last resort"])
    START --> KIND
    KIND -- "a draw: the next seed, the step's board" --> E
    KIND -- "a feedback round: the same seed,<br/>the findings, that round's board" --> E
    E --> CHK
    CHK -- "refused: learn, choose again" --> E
    CHK -- "a plan, or the 5th refusal" --> S
    E -- "plain or joint bus" --> S
    S --> G
    G --> N
    N --> A
    A -- "findings: cuts + history" --> RS
    RS --> G
    A -- "passes, or the loop stops:<br/>the plan it held" --> L
    L --> GR
    GR -- "connected and clean" --> STOP
    GR -- "nets open" --> NEXT
    NEXT -- "yes" --> FB
    NEXT -- "no, rounds left" --> DR
    NEXT -- "no rounds left" --> BEST
