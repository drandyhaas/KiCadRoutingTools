flowchart TD
    START(["the bus step: each source's buses one group,<br/>up to R rounds a group"])
    CAP["each bus's ends model captured"]
    M["the group's ends: one model (CP-SAT)<br/>every bus's teeth and berths,<br/>the arrays' whole fanout"]
    CHK{"each bus's ends<br/>put to its solve"}
    FLD["the arrays fanned out as chosen:<br/>the shared field, measured"]
    subgraph BUS["every bus on the field, at the same time"]
        S["the round's solve (CP-SAT),<br/>coupled where two buses' plans cross"]
        subgraph LOOP["the loop, 6 rounds at most"]
            G["geometry (two LPs) and polish"]
            N["snap to the grid"]
            A{"audit"}
            RS["solve again<br/>with the cuts"]
        end
        L["lay the copper, the buses in turn;<br/>a few lanes left open planned again alone"]
    end
    MRG{"merged and graded"}
    STOP(["done"])
    FB(["next round: what the buses found<br/>at their ends goes back to the model,<br/>which answers from the state it had"])
    BEST(["no rounds left:<br/>the best round's board"])
    START --> CAP
    CAP --> M
    M --> CHK
    CHK -- "refused: learn, repair" --> M
    CHK -- "every bus has a plan" --> FLD
    FLD -- "a violation the fanout made: learn" --> M
    FLD --> S
    S --> G
    G --> N
    N --> A
    A -- "findings: cuts + history" --> RS
    RS --> G
    A -- "passes, or the loop stops:<br/>the plan it held" --> L
    L --> MRG
    MRG -- "no net open, no violation,<br/>no ball walled in" --> STOP
    MRG -- "short of clean, rounds left" --> FB
    MRG -- "short of clean, none left" --> BEST
