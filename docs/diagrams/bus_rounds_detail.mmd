flowchart TD
    START(["route_bus: the buses of one source, one group (negotiated_buses.route_grouped):<br/>up to --rounds group rounds (default 4)"])
    CAP["captures: each bus's ends model as its own run builds it<br/>(route_bus --src/--dest, ENDS_CAPTURE)"]
    subgraph ENDS["the group's ends: group_ends.py"]
        M["one CP-SAT model: every bus's teeth and berths,<br/>every other ball of the arrays served<br/>(first tiers; whole menus a stretch of lanes at a time)"]
        CHK{"each bus's ends put to<br/>its whole solve (whole_solve, a check)"}
        REP["the repair: the lanes the refusal named free,<br/>every other lane held on its ends"]
        FLD{"the arrays fanned out as chosen:<br/>the shared field, the board's DRC on it"}
        TIE["the field's ties (field_ties)"]
    end
    subgraph BUS["every bus on the field at the same time, each its own whole route (GROUP_ENDS)"]
        S["the round's solve: whole_solve (CP-SAT), an unproved plan kept;<br/>coupled where two buses' plans cross (whole_joint)"]
        subgraph LOOP["the loop: LOOP_ROUNDS (6) at most"]
            G["geometry<br/>whole_geo (LP)"]
            E["geometry in board xy<br/>whole_embed (an LP a round)"]
            P["polish<br/>whole_polish"]
            N["snap: pairs first, then singles<br/>whole_snap"]
            A{"audit, gate, lint"}
            RS["re-solve, coupled,<br/>the cuts firm"]
            RE["repair_ends: a via or a tooth nudged,<br/>a passive moved, a ball escaped again;<br/>the loop again"]
        end
        L["lay, the buses in turn (the standing order): route_lanes --plan<br/>the passing plan, else the plan its loop held"]
        MINI["the mini re-route: a few lanes left open<br/>planned again alone on the laid board, one round"]
    end
    MRG{"merged, graded on the board"}
    STOP(["done"])
    FB(["next group round: what the buses' steps found at their ends<br/>goes back to the model (group_ends --from --feedback),<br/>which answers from the state it had; the buses again on that field"])
    BEST(["no rounds left: the board with the fewest nets open,<br/>then violations, then balls walled in"])
    START --> CAP
    CAP --> M
    M --> CHK
    CHK -- "refused: a lane held to one layer,<br/>two crossings held apart, an end off a layer,<br/>the state refused" --> REP
    REP --> CHK
    CHK -- "every bus has a plan" --> FLD
    FLD -- "a violation the fanout made:<br/>that end not taken again" --> REP
    FLD -- "clean" --> TIE
    TIE --> S
    S --> G
    G --> E
    E --> P
    P -- "side flips" --> G
    P --> N
    N --> A
    A -- "findings: cuts + history<br/>(this round's alone)" --> RS
    RS --> G
    A -- "ends crowded<br/>(exit 4)" --> RE
    RE --> G
    A -- "pass" --> L
    A -- "not converging, crowded again,<br/>out of loop rounds" --> L
    L -- "a few lanes open" --> MINI
    L --> MRG
    MINI --> MRG
    MRG -- "no net open, no violation,<br/>no ball walled in" --> STOP
    MRG -- "short of clean, rounds left" --> FB
    MRG -- "short of clean, none left" --> BEST
